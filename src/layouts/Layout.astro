---
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "ON REPEAT — Creativico Talent Portfolio",
  description = "Curated creative content discography for talents, creators, and entertainment brands.",
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#000000" />
  </head>
  <body>
    <slot />
  </body>
</html>
